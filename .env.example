# MyNoteApp 配置示例
#
# 复制成 .env 后按需修改：  Copy-Item .env.example .env
# .env 已被 .gitignore 排除，**不会进入版本库**。
#
# 全部配置项都有合理默认值，不写这个文件也能跑。

# ===========================================================================
# 服务（只允许回环地址 —— 填 0.0.0.0 会直接拒绝启动，防止笔记暴露到局域网）
# ===========================================================================
HOST=127.0.0.1
PORT=8765

# ===========================================================================
# 本地模型（默认走本机 Ollama，数据不出本机）
# ===========================================================================
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b

# ===========================================================================
# 云端模型（默认关闭）
#
# 开启意味着：视频字幕全文会发送给第三方服务商。
# 必须同时设置 LLM_PROVIDER=openai 和 ALLOW_CLOUD=true 才会生效。
# ===========================================================================
# LLM_PROVIDER=openai
# ALLOW_CLOUD=true
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# OPENAI_MODEL=deepseek-chat

# ===========================================================================
# B站登录态（可选）
#
# 实测结论：**未登录拿不到任何字幕**，WBI 签名也绕不过。
# 不配置也能用 —— 会自动改用本地 Whisper 转写，只是每个视频都要转写。
#
# 若要配置：浏览器登录 B站 → F12 → Application → Cookies →
#           https://www.bilibili.com → 复制 SESSDATA 的值。
#
# ⚠️ SESSDATA 等价于登录凭证，泄露即可免密登录你的账号。
#    建议用小号；本应用只把它作为请求头发送，绝不写入日志或笔记。
# ===========================================================================
# BILI_SESSDATA=xxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================================================
# 语音转写
# ===========================================================================
WHISPER_MODEL=large-v3-turbo

# auto / cuda / cpu
WHISPER_DEVICE=auto

# ⚠️ 不要改成 auto！
# auto 会选 int8，而 Blackwell(RTX 50系, sm_120) 上 int8 路径会抛
# CUBLAS_STATUS_NOT_SUPPORTED。GPU 用 float16，CPU 用 int8。
WHISPER_COMPUTE_TYPE=float16

WHISPER_LANGUAGE=zh
WHISPER_SIMPLIFY_CHINESE=true
WHISPER_USE_BATCHED=true
WHISPER_BATCH_SIZE=8

# ⚠️ 必须是完整通顺的简体句子。实测单词/短语形式完全无效。
WHISPER_INITIAL_PROMPT=以下是普通话的句子，这是一段中文讲解录音。

# ===========================================================================
# 模型权重的下载通道
#
# 实测：国内直连 huggingface.co **主站可达但文件 CDN 被阻断** ——
# 首页 179ms 正常，下载 model.bin 直接超时。
# 换成 hf-mirror.com 后实测 2.5 MB/s（1.6GB 模型约 11 分钟）。
# ===========================================================================
# HF_ENDPOINT=https://hf-mirror.com

# 关闭 HuggingFace 新的 Xet 传输协议。
# 实测：开着它国内下载会卡在 0 字节数分钟毫无进展；关掉后立刻正常。
# 默认已是关闭，一般不用改。
# HF_DISABLE_XET=true

# ===========================================================================
# B站请求策略
# ===========================================================================
# 请求最小间隔（秒），避免触发 -352/-412 风控
BILI_MIN_INTERVAL=1.0
BILI_TIMEOUT=20
BILI_MAX_RETRIES=3
# 抓多少条高赞评论当作「观众勘误」（0 = 关闭，最多 50）。
# 评论区常有人指出视频里的错误、补更准的型号和数据，笔记里会单独列一节。
BILI_TOP_COMMENTS=20

# ===========================================================================
# 笔记生成
# ===========================================================================
# 单块字符上限。显存紧张时调小。
LLM_CHUNK_CHARS=2400
LLM_CHUNK_OVERLAP_CHARS=200

# ===========================================================================
# 数据目录（相对路径会锚定到项目根目录）
# ===========================================================================
# DATA_DIR=data
# ---------------------------------------------------------------------------
# 画面识别（OCR）—— 「不单纯分析音频」
# ---------------------------------------------------------------------------
# 教程类视频的提示词、代码、命令往往只出现在画面上，音频里听不到或者听错。
# 开启后会自动下载低清视频（≤480p，20 分钟约 40~60MB）抽帧识别。
# 需要先装：pip install -r requirements-vision.txt
VISION_ENABLED=true

# 抽帧间隔（秒）。越长越快、越容易漏内容。
VISION_INTERVAL=15

# 单次最多抽多少帧（长视频会自动放宽间隔）
VISION_MAX_FRAMES=240

# 下载视频时限制的高度。只要够 OCR 看清字就行。
VISION_MAX_HEIGHT=480

# OCR 线程数。留空 = 自动取逻辑核一半。
# ⚠️ 不要填满逻辑核 —— 实测在 8P+16E 的混合架构上，
#    用满 24 线程比用 8 线程慢 3.5 倍（0.82s/帧 vs 2.88s/帧）。
# VISION_OCR_THREADS=8

# 画面文字少于这么多行时不纳入笔记（避免噪音）
VISION_MIN_LINES=3

# ---------------------------------------------------------------------------
# 生成长度上限
# ---------------------------------------------------------------------------
# ⚠️ 不要设为 -1（不限）。不设上限时生成长度只受 LLM_NUM_CTX 约束：
#    小模型一旦陷入重复会一直吐到吃满上下文，表现是「跑十分钟然后超时」——
#    既慢又没有产出。有了上限，最坏情况变成「很快返回被截断的内容」。
LLM_NUM_PREDICT=4096