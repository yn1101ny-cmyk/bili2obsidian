# 统一换行符，避免跨平台 diff 噪音
* text=auto

# Windows 脚本保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.db binary
*.sqlite binary
*.sqlite3 binary
*.mp3 binary
*.m4a binary
*.wav binary
*.mp4 binary

# 锁文件：合并冲突时不要自动处理
pnpm-lock.yaml -diff merge=binary
package-lock.json -diff merge=binary
