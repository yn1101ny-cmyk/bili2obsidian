.env
.env.*
!.env.example
*.key
*.pem
*.p12
cookies.txt
cookies*.json
secrets.*
credentials.*

# ---------------------------------------------------------------
# 用户本地数据 —— 不进入版本库（保证数据留在本机）
# ---------------------------------------------------------------
data/
notes/
media/
cache/
models/
*.db
*.db-journal
*.sqlite
*.sqlite3
*.duckdb

# ---------------------------------------------------------------
